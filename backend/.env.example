# Gemini (Google AI Studio) API key used by chain.py
GOOGLE_API_KEY=

# Supabase project settings (Settings -> API in the Supabase dashboard)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Comma-separated list of allowed frontend origins for CORS
FRONTEND_ORIGIN=http://localhost:5173

# Pinecone (RAG: research-grounded segment reasoning, see backend/rag/)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=marketing-segment-research
PINECONE_EMBEDDING_MODEL=models/gemini-embedding-001
PINECONE_EMBEDDING_DIMENSION=768
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
RAG_TOP_K=3
